# ==========================================
# PAKIV EMPLOYEE VERIFICATION PORTAL CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME=Pakiv Employee Verification Portal

# Domains & URLs
# Frontend public domain: employees.pakiv.com
# Backend API domain: api-employees.pakiv.com
CLIENT_URL=http://localhost:5000
PUBLIC_VERIFY_BASE_URL=http://localhost:5000/verifyemp
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://employees.pakiv.com,https://api-employees.pakiv.com

# MongoDB Atlas Database URI
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/pakiv_emp_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pakiv_emp_verification

# JWT Authentication
JWT_SECRET=pakiv_super_secure_jwt_secret_key_change_in_production_2026_xyz!@#
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_SECRET=pakiv_super_secure_refresh_secret_change_in_production_2026_abc$%^
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=pakiv_cookie_secret_change_in_production_2026_cookie_key

# Cloudflare R2 Object Storage (AWS S3-compatible)
# Retrieve from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pakiv-employee-assets
# Public custom domain or workers.dev URL for Cloudflare R2 bucket:
# Example: https://assets.pakiv.com or https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL=

# Default Super Admin Seed Credentials (for initial deployment)
DEFAULT_ADMIN_EMAIL=admin@pakiv.com
DEFAULT_ADMIN_PASSWORD=PakivAdmin2026!Secure
DEFAULT_ADMIN_NAME=Pakiv Super Admin

